{
  "name": "genshin-randomiser",
  "version": "0.1.0",
  "private": true,
  "description": "Randomise Genshin Impact teams from configurable character pools.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "data": "node scripts/fetch-characters.mjs"
